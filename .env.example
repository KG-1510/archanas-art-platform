# Copy to .env.local and fill in. Never commit .env.local.

# Optional. Overrides the site address (no trailing slash). Leave unset normally:
# production builds use https://archanasart.in and local development uses localhost.
NEXT_PUBLIC_SITE_URL=

# Sanity (https://www.sanity.io/manage)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Editor token, server only. Used to save orders and mark paintings sold.
SANITY_API_WRITE_TOKEN=

# Razorpay (https://dashboard.razorpay.com/app/keys)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret you set when creating the webhook to /api/razorpay/webhook
RAZORPAY_WEBHOOK_SECRET=

# Admin panel (/admin). One entry per person, made with: node scripts/admin-password.mjs
# Join several people with a semicolon. Only password hashes go here, never passwords.
ADMIN_USERS=
# A long random string (32+ characters) that signs the admin sign-in cookie. Make one with: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# Order emails through Brevo (optional; orders work without it).
BREVO_API_KEY=
# The sender's address, verified in Brevo. For example: orders@archanasart.in
ORDERS_FROM_EMAIL=
# Where the studio's own "new order" alert goes.
ORDERS_NOTIFY_EMAIL=
